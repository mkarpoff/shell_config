" Minimal portable vimrc, derived from ~/.vim/vimrc (mkarpoff).
" Stock vim 7.4+ / neovim, no plugins, no external tools.
" Copy to ~/.vimrc (or ~/.config/nvim/init.vim for neovim).

set nocompatible
set backspace=2              " same as indent,eol,start

" Quiet: no bell, audible or visual
if exists('+belloff')
  set belloff=all
else
  set noerrorbells visualbell t_vb=
endif

if has('multi_byte')
  set encoding=utf-8
endif

" Indenting
set autoindent
set tabstop=2 softtabstop=2 shiftwidth=2

filetype plugin on
syntax enable

" Persistent undo, kept in ~/.vim/undodir (created on first run)
if has('persistent_undo')
  if !isdirectory($HOME . '/.vim/undodir') && exists('*mkdir')
    call mkdir($HOME . '/.vim/undodir', 'p')
  endif
  set undofile
  set undodir=$HOME/.vim/undodir
  set undolevels=1000 undoreload=10000
endif

" viminfo in ~/.vim (neovim uses shada instead)
if !has('nvim') && isdirectory($HOME . '/.vim')
  set viminfo+=n$HOME/.vim/info
endif

" Key timeouts and mappings
set timeoutlen=1000 ttimeoutlen=10
noremap! jk <Esc>
noremap! Jk <Esc>
noremap! jK <Esc>
noremap! JK <Esc>

noremap ww <C-w>
if has('terminal')
  tnoremap ww <C-w>
  tnoremap ww; <C-w>:
endif

noremap ; :

nnoremap gc :tabe<CR>
nnoremap gC :tabe<Space>
nnoremap gn :tabnext<CR>

cnoremap <C-a> <Home>
cnoremap <C-e> <End>

" Add the current directory tree to 'path'
command! PathAdd set path+=$PWD/**

" Paste mode toggle on Ctrl-p
function! PasteToggle()
  if &paste
    set nopaste
    echo 'Paste off'
  else
    set paste
    echo 'Paste on'
  endif
endfunction
command! -nargs=0 PasteToggle call PasteToggle()
noremap <C-p> <Esc>:call PasteToggle()<CR>

" Search highlight toggle: :HS, or type hs at the start of the command line
function! HighlightSearch()
  if &hlsearch
    set nohlsearch
    echo 'Search highlight off'
  else
    set hlsearch
    echo 'Search highlight on'
  endif
endfunction
command! -nargs=0 HS call HighlightSearch()
cnoremap <nowait> <expr> hs getcmdtype() ==# ':' && getcmdpos() == 1 ? 'HS' : 'hs'

" Color column from N to the right edge. :ColorColumn 0 turns it off.
" (Changed from the original, which turned on every column for 0.)
if exists('+colorcolumn')
  function! ColorColumn(col)
    let &colorcolumn = a:col > 0 ? join(range(a:col, 999), ',') : ''
  endfunction
  command! -nargs=1 ColorColumn call ColorColumn(<f-args>)
endif

" Show whitespace: :WSToggle
if has('patch-7.4.710') && &encoding ==# 'utf-8'
  set listchars=eol:¬,tab:>•,trail:~,extends:>,precedes:<,space:·
  command! WSToggle set invlist
endif

" Close the quickfix window if it is the last window
augroup QFClose
  autocmd!
  autocmd WinEnter * if winnr('$') == 1 && getbufvar(winbufnr(winnr()), '&buftype') ==# 'quickfix' | quit | endif
augroup END

" Zoom / restore the current window: wwf
function! s:ZoomToggle() abort
  if exists('t:zoomed') && t:zoomed
    execute t:zoom_winrestcmd
    let t:zoomed = 0
  else
    let t:zoom_winrestcmd = winrestcmd()
    resize
    vertical resize
    let t:zoomed = 1
  endif
endfunction
command! ZoomToggle call s:ZoomToggle()
nnoremap <silent> wwf :ZoomToggle<CR>
if has('terminal')
  tnoremap <silent> wwf <C-w>:ZoomToggle<CR>
endif

augroup vimrc
  autocmd!
  " Jump to the last cursor position when reopening a file
  autocmd BufReadPost * if line("'\"") > 0 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
  autocmd BufNewFile,BufRead *.log set filetype=log
  autocmd BufNewFile,BufRead *.h set filetype=cpp
augroup END

" Stock colorscheme close to the custom desert-mkarpoff
if has('syntax')
  silent! colorscheme desert
endif

if filereadable(expand('~/.vim/statusline.vim')) | source ~/.vim/statusline.vim | endif
