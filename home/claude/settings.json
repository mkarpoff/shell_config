{
  "awsCredentialExport": "\"$HOME/.toolbox/bin/claude\" default-credential-export",
  "env": {
    "AWS_REGION": "us-west-2"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "Bash(ls *)",
      "Bash(cd *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(git *)",
      "Bash(brazil*)",
      "Bash(cr *)",
      "Bash(ada *)",
      "Bash(aws * describe*)",
      "Bash(aws * list*)",
      "Bash(aws * get*)",
      "Bash(aws sts *)",
      "Bash(aws rds generate-db-auth-token *)",
      "Bash(aws logs *)",
      "Bash(aim *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(time *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(xargs *)",
      "Bash(brazil-build *)",
      "Bash(jar tf *)",
      "Bash(jar tvf *)",
      "Bash(unzip -l *)",
      "Bash(gh *)",
      "Bash(pbcopy)",
      "Bash(pbpaste)",
      "simple_expansion",
      "mcp__builder-mcp__*",
      "mcp__slack-mcp__*",
      "mcp__m365-mcp__*",
      "mcp__design-inspector-mcp__*",
      "mcp__chorus-mcp__*",
      "mcp__prompt-mcp__*"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(mwinit*)"
    ],
    "ask": [
      "Bash(aws * delete*)",
      "Bash(aws * terminate*)",
      "Bash(aws * remove*)",
      "Bash(aws cloudformation delete-stack*)",
      "Bash(aws ec2 terminate-instances*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/ws",
      "/home/mkarpoff",
      "/tmp"
    ]
  },
  "model": "global.anthropic.claude-opus-4-8[1m]",
  "fallbackModel": [
    "global.anthropic.claude-opus-4-8[1m]",
    "global.anthropic.claude-opus-4-7[1m]",
    "global.anthropic.claude-opus-4-6-v1[1m]"
  ],
  "availableModels": [
    "claude-opus-4-6[1m]",
    "claude-opus-4-6",
    "claude-opus-4-7[1m]",
    "claude-opus-4-7",
    "claude-opus-4-8[1m]",
    "claude-opus-4-8",
    "claude-opus-5[1m]",
    "claude-opus-5",
    "claude-sonnet-4-6",
    "claude-sonnet-4-6[1m]",
    "claude-sonnet-5",
    "claude-fable-5",
    "claude-fable-5[1m]",
    "claude-haiku-4-5"
  ],
  "enforceAvailableModels": true,
  "modelOverrides": {
    "claude-opus-4-6[1m]": "global.anthropic.claude-opus-4-6-v1[1m]",
    "claude-opus-4-6": "global.anthropic.claude-opus-4-6-v1",
    "claude-opus-4-7[1m]": "global.anthropic.claude-opus-4-7[1m]",
    "claude-opus-4-7": "global.anthropic.claude-opus-4-7",
    "claude-opus-4-8[1m]": "global.anthropic.claude-opus-4-8[1m]",
    "claude-opus-4-8": "global.anthropic.claude-opus-4-8",
    "claude-opus-5[1m]": "global.anthropic.claude-opus-5[1m]",
    "claude-opus-5": "global.anthropic.claude-opus-5",
    "claude-sonnet-4-6": "global.anthropic.claude-sonnet-4-6",
    "claude-sonnet-4-6[1m]": "global.anthropic.claude-sonnet-4-6[1m]",
    "claude-sonnet-5": "global.anthropic.claude-sonnet-5",
    "claude-fable-5": "global.anthropic.claude-fable-5[1m]",
    "claude-fable-5[1m]": "global.anthropic.claude-fable-5[1m]",
    "claude-haiku-4-5": "global.anthropic.claude-haiku-4-5-20251001-v1:0"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 1,
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "AmazonBuilderCoreAIAgents-pipeline-assistant@aim": true,
    "AmazonBuilderCoreAIAgents-core@aim": true,
    "mkarpoff-skills@local": true
  },
  "extraKnownMarketplaces": {
    "aim": {
      "source": {
        "source": "directory",
        "path": "/home/mkarpoff/.aim/cc-plugins"
      }
    },
    "local": {
      "source": {
        "source": "directory",
        "path": "/home/mkarpoff/.claude/plugins/data"
      }
    }
  },
  "companyAnnouncements": [
    "Claude Code usage is cleared for Business Data per the AI For Me Guidance.\nITAR, PII, Customer Data, and more are strictly prohibited for use within this tool.\nRead more: https://w.amazon.com/bin/view/Security/AI-Security/AIforMe-Guidance#HDATAANDEXAMPLESQUICKREFERENCETABLE"
  ],
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jk": "<Esc>"
  },
  "skipAutoPermissionPrompt": true
}